---
import type { CollectionEntry } from 'astro:content';
import { calendarDays, dayKey, formatDate, formatDateRange, tripDuration } from '../utils/dates';
import GalleryDialog from './GalleryDialog.astro';

interface Props {
  trip: CollectionEntry<'trips'>;
  moments: CollectionEntry<'moments'>[];
}

const { trip, moments } = Astro.props;
const days = calendarDays(trip.data.startDate, trip.data.endDate);
const momentsByDay = new Map(moments.map((moment) => [dayKey(moment.data.date), moment]));
const duration = tripDuration(trip.data.startDate, trip.data.endDate);
const galleryId = 'calendar-gallery';
const slideDays = days.flatMap((day) => {
  const moment = momentsByDay.get(day.key);
  return moment ? [{ day, moment }] : [];
});
const slideIndexByMoment = new Map(slideDays.map(({ moment }, index) => [moment.id, index]));
const gallerySlides = slideDays.map(({ moment }, index) => ({
  href: `/trips/${trip.id}/#${moment.id}`,
  eyebrow: `День ${String(slideDays[index]!.day.number).padStart(2, '0')} · ${moment.data.city}`,
  date: moment.data.date,
  title: moment.data.title,
  bodyHtml: moment.rendered?.html ?? '',
  media: moment.data.media,
}));
---

<section class="media-calendar section-shell" id="calendar" aria-labelledby="calendar-title">
  <div class="section-heading">
    <div>
      <p class="eyebrow">Media calendar</p>
      <h2 id="calendar-title">День за днём.<br /><em>Кадр за кадром.</em></h2>
    </div>
    <p class="section-description">Маленькая хроника большого путешествия. Выберите город или откройте любой день, чтобы увидеть историю.</p>
  </div>

  <div class="calendar-panel" data-calendar-root>
    <div class="calendar-toolbar">
      <div class="calendar-filters" role="group" aria-label="Фильтр дней по городам">
        <button type="button" data-filter="all" aria-pressed="true">Все дни <span>{moments.length}</span></button>
        {trip.data.cities.map((city) => {
          const count = moments.filter((moment) => moment.data.citySlug === city.slug).length;
          return <button type="button" data-filter={city.slug} aria-pressed="false">{city.name} <span>{count}</span></button>;
        })}
      </div>
      <p class="calendar-date-range">{formatDateRange(trip.data.startDate, trip.data.endDate)}</p>
    </div>

    <div class="calendar-subline">
      <span>{duration} дней пути</span>
      <span><i></i> Есть заметка <i class="empty"></i> День без записи</span>
    </div>

    <div class="calendar-grid">
      {days.map((day) => {
        const moment = momentsByDay.get(day.key);
        if (!moment) {
          return (
            <div class="calendar-day is-empty" data-calendar-day data-city="none">
              <span class="calendar-day-number">{String(day.number).padStart(2, '0')}</span>
              <span class="empty-day-mark" aria-hidden="true"></span>
              <span class="sr-only">День {day.number}, {formatDate(day.date, true)}. Нет заметки.</span>
            </div>
          );
        }

        const cover = moment.data.media[0];
        return (
          <button
            class="calendar-day has-moment"
            type="button"
            data-calendar-day
            data-city={moment.data.citySlug}
            data-dialog-target={galleryId}
            data-slide-index={slideIndexByMoment.get(moment.id)}
            aria-label={`День ${day.number}, ${formatDate(day.date, true)}, ${moment.data.city}. ${moment.data.title}`}
          >
            {cover?.type === 'video'
              ? cover.poster
                ? <img src={cover.poster} alt="" width="1600" height="1200" loading="lazy" decoding="async" />
                : <span class="note-mark" aria-hidden="true">▶</span>
              : cover
                ? <img src={cover.src} alt="" width="1600" height="1200" loading="lazy" decoding="async" />
                : <span class="note-mark" aria-hidden="true">✎</span>}
            <span class="calendar-day-overlay"></span>
            <span class="calendar-day-number">{String(day.number).padStart(2, '0')}</span>
            <span class="calendar-city">{moment.data.city}</span>
            <span class="calendar-open" aria-hidden="true">+</span>
          </button>
        );
      })}
    </div>

    <div class="calendar-footer">
      <p data-filter-status aria-live="polite">Показано {moments.length} из {moments.length} моментов</p>
      <a class="text-link" href={`/trips/${trip.id}/`}>Вся история поездки <span aria-hidden="true">→</span></a>
    </div>
  </div>

  <GalleryDialog id={galleryId} slides={gallerySlides} />
</section>

<script>
  const calendars = document.querySelectorAll<HTMLElement>('[data-calendar-root]');

  calendars.forEach((calendar) => {
    const filters = calendar.querySelectorAll<HTMLButtonElement>('[data-filter]');
    const days = calendar.querySelectorAll<HTMLElement>('[data-calendar-day]');
    const status = calendar.querySelector<HTMLElement>('[data-filter-status]');

    filters.forEach((filterButton) => {
      filterButton.addEventListener('click', () => {
        const selectedFilter = filterButton.dataset.filter ?? 'all';
        filters.forEach((button) => button.setAttribute('aria-pressed', String(button === filterButton)));
        days.forEach((day) => {
          day.hidden = selectedFilter !== 'all' && day.dataset.city !== selectedFilter;
        });

        const visibleMoments = Array.from(days).filter(
          (day) => !day.hidden && day.hasAttribute('data-dialog-target'),
        ).length;
        const totalMoments = Array.from(days).filter((day) => day.hasAttribute('data-dialog-target')).length;
        if (status) status.textContent = `Показано ${visibleMoments} из ${totalMoments} моментов`;
      });
    });
  });

</script>
