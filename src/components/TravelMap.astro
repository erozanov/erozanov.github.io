---
import 'leaflet/dist/leaflet.css';

export interface MapMarker {
  lat: number;
  lng: number;
  label: string;
  popup?: string;
}

interface Props {
  markers: MapMarker[];
  zoom?: number;
  fit?: boolean;
  class?: string;
}

const { markers, zoom = 11, fit = false, class: className } = Astro.props;
const mapId = `map-${crypto.randomUUID()}`;
---

<div
  id={mapId}
  class:list={['travel-map', className]}
  data-travel-map
  data-zoom={zoom}
  data-fit={String(fit)}
  data-markers={JSON.stringify(markers)}
></div>

<script>
  import L from 'leaflet';

  const TILE_URL = 'https://tile.openstreetmap.org/{z}/{x}/{y}.png';
  const ATTRIBUTION =
    '&copy; <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noreferrer">OpenStreetMap contributors</a>';

  const pinIcon = () =>
    L.divIcon({
      className: 'map-pin-wrap',
      html: '<span class="map-pin"></span>',
      iconSize: [18, 18],
      iconAnchor: [9, 9],
    });

  document.querySelectorAll<HTMLElement>('[data-travel-map]').forEach((element) => {
    const markers = JSON.parse(element.dataset.markers ?? '[]') as Array<{
      lat: number;
      lng: number;
      label: string;
      popup?: string;
    }>;

    const map = L.map(element, { scrollWheelZoom: false, attributionControl: false });
    L.control.attribution({ prefix: false }).addTo(map);
    L.tileLayer(TILE_URL, { attribution: ATTRIBUTION, maxZoom: 19 }).addTo(map);

    const points = markers.map((marker) => {
      const pin = L.marker([marker.lat, marker.lng], { icon: pinIcon() }).addTo(map);
      pin.bindTooltip(marker.label, { direction: 'top', offset: [0, -10], className: 'map-label' });
      if (marker.popup) pin.bindPopup(marker.popup);
      return [marker.lat, marker.lng] as [number, number];
    });

    if (element.dataset.fit === 'true' && points.length > 0) {
      map.fitBounds(L.latLngBounds(points), { padding: [48, 48], maxZoom: 6 });
    } else if (points.length > 0) {
      map.setView(points[0], Number(element.dataset.zoom ?? 11));
    }
  });
</script>
