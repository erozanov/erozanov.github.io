---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import JourneyShelf from '../components/JourneyShelf.astro';
import MediaCalendar from '../components/MediaCalendar.astro';
import TopicMoments from '../components/TopicMoments.astro';
import BestMoments from '../components/BestMoments.astro';

const trips = (await getCollection('trips', ({ data }) => data.status === 'published')).sort(
  (a, b) => b.data.startDate.valueOf() - a.data.startDate.valueOf(),
);
const moments = (await getCollection('moments', ({ data }) => data.status === 'published')).sort(
  (a, b) => a.data.date.valueOf() - b.data.date.valueOf(),
);
const latestTrip = trips[0];

if (!latestTrip) throw new Error('Добавьте хотя бы одну опубликованную поездку.');

const latestMoments = moments.filter((moment) => moment.data.trip.id === latestTrip.id);
---

<BaseLayout image={latestTrip.data.cover}>
  <SiteHeader />
  <main id="main-content">
    <section class="home-intro section-shell" aria-labelledby="home-title">
      <div>
        <p class="eyebrow">Семейный архив путешествий</p>
        <h1 id="home-title">Истории, которые хочется<br />перечитывать <em>снова.</em></h1>
      </div>
      <div class="intro-aside">
        <p>Живые заметки, фотографии и маленькие наблюдения. Не идеальные маршруты — настоящие впечатления.</p>
        <a class="text-link" href="#journeys">Листать архив <span aria-hidden="true">↓</span></a>
      </div>
    </section>

    <JourneyShelf trips={trips} moments={moments} />
    <MediaCalendar trip={latestTrip} moments={latestMoments} />
    <TopicMoments trips={trips} moments={moments} />
    <BestMoments trips={trips} moments={moments} />

    <section class="journal-manifesto section-shell" id="about" aria-labelledby="about-title">
      <p class="eyebrow">Зачем всё это</p>
      <h2 id="about-title">Не просто где мы были.<br /><em>А как это было.</em></h2>
      <div class="manifesto-footer">
        <p>Голосовая заметка на прогулке становится частью истории. Фотография возвращает в момент. А общие темы помогают найти его снова — по вкусу, месту или настроению.</p>
        <span>Сделано для семьи и с любовью к дороге.</span>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
